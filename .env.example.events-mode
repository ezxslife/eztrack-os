# .env.example.events-mode
#
# New environment variables introduced by Events Mode (ezxs-track).
# Merge these into your existing .env.example and .env.local.
#
# Web app (apps/web)
# ============================================================================

# Default UI mode for the workspace ('security' | 'events' | 'both')
NEXT_PUBLIC_VENUE_MODE_DEFAULT=security

# Mobile app (apps/mobile)
# ============================================================================

EXPO_PUBLIC_VENUE_MODE_DEFAULT=security

# Edge Function secrets (set via `supabase secrets set KEY=VALUE`, NOT in .env)
# ============================================================================
# These are reference-only — do not commit values.
#
#   EVENTBRITE_WEBHOOK_SECRET   from Eventbrite app webhook config
#   STRIPE_WEBHOOK_SECRET       from Stripe dashboard webhook endpoint
#   SQUARE_WEBHOOK_SECRET       from Square developer dashboard
#
# Run:
#   supabase secrets set EVENTBRITE_WEBHOOK_SECRET=<value>
#   supabase secrets set STRIPE_WEBHOOK_SECRET=<value>
#
# Existing SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are inherited automatically
# inside Edge Functions by the Supabase platform.

# OAuth (added in L0b — auth port from ezxs-os)
# ============================================================================
# These will be needed once the Google/Apple OAuth flows land. Empty in L0a.
#
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#   APPLE_CLIENT_ID=
#   APPLE_TEAM_ID=
#   APPLE_KEY_ID=
#   APPLE_PRIVATE_KEY=
